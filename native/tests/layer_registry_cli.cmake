# These CLI probes only enumerate registrations or reject malformed arguments.
# They never submit a valid mutation and never request elevation.
function(expect_rejected)
 execute_process(COMMAND "${HELPER}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
 if(NOT code EQUAL 87)
  message(FATAL_ERROR "Malformed command returned ${code}; expected 87. ${error}")
 endif()
endfunction()
expect_rejected()
expect_rejected(--inventory arbitrary-output.json)
expect_rejected(--elevate-set HKCU 64 implicit "C:\\Layers\\test.json" 0 1)
expect_rejected(--set HKLM 64 implicit "C:\\Layers\\test.json" 0 4294967296)
expect_rejected(--set HKLM 64 arbitrary-key "C:\\Layers\\test.json" 0 1)
expect_rejected(--set HKLM 64 implicit "relative.json" 0 1)
execute_process(COMMAND "${HELPER}" --inventory RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "Read-only inventory returned ${code}: ${error}")
endif()
string(JSON entries_type TYPE "${output}" entries)
string(JSON errors_type TYPE "${output}" errors)
if(NOT entries_type STREQUAL "ARRAY" OR NOT errors_type STREQUAL "ARRAY")
 message(FATAL_ERROR "Inventory must contain entries and errors arrays")
endif()
string(JSON count LENGTH "${output}" entries)
if(count GREATER 0)
 math(EXPR last "${count} - 1")
 foreach(index RANGE 0 ${last})
  foreach(field scope view kind manifest type)
   string(JSON field_type TYPE "${output}" entries ${index} ${field})
   if(NOT field_type STREQUAL "STRING")
    message(FATAL_ERROR "Inventory entry ${index}.${field} is not a string")
   endif()
  endforeach()
  string(JSON value_type TYPE "${output}" entries ${index} value)
  if(NOT value_type STREQUAL "NUMBER" AND NOT value_type STREQUAL "NULL")
   message(FATAL_ERROR "Inventory values must be numeric or null")
  endif()
 endforeach()
endif()
message(STATUS "CLI rejection and read-only inventory passed (${count} entries)")
