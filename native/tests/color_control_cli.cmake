foreach(operation --color-status --color-cycle)
 execute_process(COMMAND "${HELPER}" ${operation} --game arbitrary RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
 string(JSON available GET "${output}" available)
 string(JSON supported GET "${output}" supported)
 string(JSON enabled GET "${output}" enabled)
 string(JSON preset GET "${output}" activePreset)
 string(JSON active GET "${output}" effectActive)
 string(JSON message GET "${output}" error)
 if(available OR supported OR enabled OR active OR NOT preset STREQUAL "neutral" OR NOT message MATCHES "Unsupported game")
  message(FATAL_ERROR "Invalid game did not produce a safe color status: ${output}")
 endif()
 if(operation STREQUAL "--color-cycle" AND NOT result EQUAL 1)
  message(FATAL_ERROR "Rejected cycle needs a failure exit code")
 endif()
endforeach()
execute_process(COMMAND "${HELPER}" --color-cycle --game lmu --key F1 RESULT_VARIABLE result OUTPUT_VARIABLE output)
string(JSON message GET "${output}" error)
if(NOT result EQUAL 1 OR NOT message MATCHES "Invalid color command")
 message(FATAL_ERROR "Color command accepted arbitrary extra input arguments")
endif()
